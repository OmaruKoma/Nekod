{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nekod.dev/schemas/v1/declarative-patch.schema.json",
  "title": "Nekod Declarative Patch Payload v1",
  "description": "Bounded, auditable instruction set for declarative_patch_v1 trainer entrypoints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/DeclarativeFeatureEntry"
      }
    }
  },
  "$defs": {
    "ModuleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "HexBytes": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{2}(?:\\s+[0-9A-Fa-f]{2}){0,63}$"
    },
    "AobPattern": {
      "type": "string",
      "pattern": "^(?:[0-9A-Fa-f]{2}|\\?\\?)(?:\\s+(?:[0-9A-Fa-f]{2}|\\?\\?)){0,127}$"
    },
    "AddressLocator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module", "offset"],
          "properties": {
            "kind": { "const": "module_offset" },
            "module": { "$ref": "#/$defs/ModuleName" },
            "offset": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module", "pattern"],
          "properties": {
            "kind": { "const": "aob_pattern" },
            "module": { "$ref": "#/$defs/ModuleName" },
            "pattern": { "$ref": "#/$defs/AobPattern" },
            "match_index": { "type": "integer", "minimum": 0, "default": 0 },
            "offset": { "type": "integer", "default": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module", "base_offset", "offsets"],
          "properties": {
            "kind": { "const": "pointer_chain" },
            "module": { "$ref": "#/$defs/ModuleName" },
            "base_offset": { "type": "integer", "minimum": 0 },
            "offsets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "integer" }
            }
          }
        }
      ]
    },
    "DeclarativeOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "patch_bytes"],
          "properties": {
            "kind": { "const": "byte_patch" },
            "locator": { "$ref": "#/$defs/AddressLocator" },
            "expected_original_bytes": { "$ref": "#/$defs/HexBytes" },
            "patch_bytes": { "$ref": "#/$defs/HexBytes" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "value_type"],
          "properties": {
            "kind": { "const": "write_value" },
            "locator": { "$ref": "#/$defs/AddressLocator" },
            "value_type": {
              "type": "string",
              "enum": ["i32", "u32", "i64", "u64", "f32", "f64"]
            },
            "value": { "type": "number" },
            "freeze_interval_ms": {
              "type": "integer",
              "minimum": 50,
              "maximum": 1000
            }
          }
        }
      ]
    },
    "DeclarativeFeatureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "operations"],
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/DeclarativeOperation" }
        }
      }
    }
  }
}
