      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F6",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "damage-reduction-max",
      "name": "100% 伤害减免",
