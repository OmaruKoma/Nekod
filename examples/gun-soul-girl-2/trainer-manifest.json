{
  "schema_version": "1.0.0",
  "id": "org.nekod.gun-soul-girl-2",
  "version": "1.0.0",
  "name": "GunSoul Girl 2 专属单机修改器 (Unity Mono)",
  "description": "面向 GunSoul Girl 2 (Steam Build 13294226 / Unity Mono) 的专属反射修改包，通过 NekodUnityBridge (BepInEx 5 Mono) 仅绑定玩家专属类（vThirdPersonController、vShooterManager、GS2_CharacterControllerStat、GS2Inventory、BagData、GS2_GameController），不增强敌方属性。",
  "authors": [
    {
      "name": "Nekod Contributors",
      "github": "OmaruKoma",
      "url": "https://github.com/OmaruKoma/Nekod"
    }
  ],
  "license": "MIT",
  "source_repository": "https://github.com/OmaruKoma/Nekod",
  "target_game": {
    "game_id": "gun-soul-girl-2",
    "game_name": "GunSoul Girl 2",
    "store_ids": {
      "steam_app_id": 1948700
    }
  },
  "supported_versions": [
    {
      "platform": "windows-x64",
      "version_pattern": "*",
      "status": "verified"
    }
  ],
  "runtime": {
    "kind": "unity_bridge_v1",
    "api_version": "1.0.0",
    "min_nekod_version": "0.1.0-alpha.0",
    "entrypoint": "scripts/unity_bridge.json",
    "supported_platforms": ["windows-x64"]
  },
  "permissions": [
    {
      "scope": "process.discover",
      "reason": "按 PID 匹配 %LOCALAPPDATA%\\Nekod\\bridges\\unity-<pid>.json 发现 GunSoul Girl 2 伴生桥接端口。",
      "required": true
    },
    {
      "scope": "process.write_memory",
      "reason": "通过 NekodUnityBridge 本地回环 RPC 修改玩家属性、武器状态与背包货币资源。",
      "required": true
    }
  ],
  "features": [
    {
      "id": "god-mode",
      "name": "玩家无敌 (God Mode)",
      "description": "锁定 Invector vThirdPersonController.isImmortal（仅影响玩家，不影响敌人）。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F1",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "infinite-ammo",
      "name": "无限弹药",
      "description": "启用玩家 vShooterManager.AllAmmoInfinity，射击不消耗备弹。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F2",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "no-recoil",
      "name": "武器无后坐力",
      "description": "关闭 vShooterManager.applyRecoilToCamera 镜头后坐力抖动。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F3",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "instant-stamina",
      "name": "耐力秒回满",
      "description": "将 vThirdPersonController.staminaRecovery 设为 999.0，退出自动回滚至 1.2。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F4",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "zero-sprint-stamina",
      "name": "冲刺零耐力消耗",
      "description": "将 vThirdPersonController.sprintStamina 设为 0.0，退出回滚至 30.0。",
      "category": "player",
      "control_type": "toggle",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "guaranteed-crit",
      "name": "100% 暴击率",
      "description": "设置玩家 GS2_CharacterControllerStat.CriticalRate 为 100.0。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F5",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "zero-cooldown",
      "name": "技能无冷却",
