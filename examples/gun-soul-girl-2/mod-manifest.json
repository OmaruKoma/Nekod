{
  "schema_version": "2.0.0",
  "package_format": "nmod_v1",
  "mod_kind": "script_mod",
  "id": "org.nekod.gun-soul-girl-2",
  "version": "1.2.0",
  "name": "GunSoul Girl 2 专属单机修改器 (Unity Mono)",
  "description": "面向 GunSoul Girl 2 (Steam Build 13294226 / Unity Mono) 的专属反射修改包，通过 NekodUnityBridge v0.4.0 (BepInEx 5 Mono) 直接修改并持续锁定玩家专属武器/移动/技能节点，并支持相机自动锁怪与范围杀戮光环，切换关卡与队列角色自动生效且不增强敌方。",
  "authors": [
    {
      "name": "Nekod Contributors",
      "github": "OmaruKoma",
      "url": "https://github.com/OmaruKoma/Nekod"
    }
  ],
  "license": "MIT",
  "source_repository": "https://github.com/OmaruKoma/Nekod",
  "target_game": {
    "game_id": "gun-soul-girl-2",
    "game_name": "GunSoul Girl 2",
    "store_ids": {
      "steam_app_id": 1948700
    }
  },
  "supported_versions": [
    {
      "platform": "windows-x64",
      "version_pattern": "*",
      "status": "verified"
    }
  ],
  "runtime": {
    "kind": "unity_bridge_v1",
    "api_version": "1.0.0",
    "min_nekod_version": "0.1.0-alpha.0",
    "entrypoint": "scripts/unity_bridge.json",
    "supported_platforms": ["windows-x64"]
  },
  "dependencies": [
    {
      "dependency_id": "bepinex-mono",
      "kind": "mod_loader",
      "version_req": ">=5.4.0",
      "optional": false,
      "redistribution": "local_detect_only"
    },
    {
      "dependency_id": "nekod-unity-bridge",
      "kind": "runtime_bridge",
      "version_req": ">=0.4.0",
      "optional": false,
      "redistribution": "local_detect_only"
    }
  ],
  "permissions": [
    {
      "scope": "process.discover",
      "reason": "按 PID 匹配 %LOCALAPPDATA%\\Nekod\\bridges\\unity-<pid>.json 发现 GunSoul Girl 2 伴生桥接端口。",
      "required": true
    },
    {
      "scope": "process.write_memory",
      "reason": "通过 NekodUnityBridge 本地回环 RPC 修改玩家属性、武器状态与背包货币资源。",
      "required": true
    }
  ],
  "features": [
    {
      "id": "god-mode",
      "name": "玩家无敌 (God Mode)",
      "description": "持续锁定玩家 vThirdPersonController.isImmortal（切场景/切换队列角色自动生效，不影响敌人）。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F1",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "infinite-ammo",
      "name": "无限弹药",
      "description": "同时锁定玩家 vShooterManager.AllAmmoInfinity 与当前武器 rWeapon.isInfinityAmmo / dontUseReload（免换弹、不耗备弹，仅玩家生效）。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F2",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "no-recoil",
      "name": "武器无后坐力",
      "description": "关闭 vShooterManager.applyRecoilToCamera 镜头后坐力并锁定 rWeapon.dispersion = 0（无后坐力 + 零散布）。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F3",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "instant-stamina",
      "name": "耐力秒回满",
      "description": "将 vThirdPersonController.staminaRecovery 持续锁定为 999.0，退出自动回滚至 1.2。",
      "category": "player",
      "control_type": "toggle",
      "default_hotkey": "F4",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "zero-sprint-stamina",
      "name": "冲刺零耐力消耗",
      "description": "将 vThirdPersonController.sprintStamina 持续锁定为 0.0，退出回滚至 30.0。",
      "category": "player",
      "control_type": "toggle",
      "mutates_memory": true,
      "supports_rollback": true,
      "risk_level": "low"
    },
    {
      "id": "guaranteed-crit",
